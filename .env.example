# AI features: configure as a server-side secret where possible.
GEMINI_API_KEY=""

# Public application origin used by server-generated URLs.
APP_URL="https://picshrinkpro.com"

# Optional Supabase browser client configuration.
# Only use the publishable/anon key here, with Row Level Security enabled.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Cloudflare Worker secrets (never prefix these with VITE_).
# Configure with: npx wrangler secret put SECRET_NAME
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# SESSION_SECRET=  # Generate at least 32 bytes of cryptographically random data.
#
# Future CMS infrastructure:
# D1 database and R2 bucket identifiers belong in wrangler.jsonc bindings,
# not in browser-exposed VITE_ variables.
#
# Never commit real credentials, API keys, service-role keys, or session secrets.
