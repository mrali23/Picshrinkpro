{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picshrinkpro",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-26",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ADMIN_DATA", "class_name": "AdminData" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdminData"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
